{{- /*
  Multilingual sitemap for each Hugo language site.

  Hugo emits a root sitemap index for multilingual builds, then one sitemap per
  language. This template fills each language sitemap with live pages and the
  matching hreflang alternate set.
*/ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $translationStatusData := (index hugo.Data "translation_status").pages -}}
{{- $liveStatuses := slice "reviewed" "community_corrected" "live" -}}
{{- $currentLang := .Site.Language.Params.bcp47 | default (.Site.Language.LanguageCode | default .Site.Language.Lang) -}}
{{- $includedKinds := slice "home" "section" "page" -}}
{{- range .Site.Pages -}}
  {{- $page := . -}}
  {{- if not (in $includedKinds .Kind) }}{{ continue }}{{ end -}}
  {{- $canonicalPath := .Params.canonical_path | default .RelPermalink -}}
  {{- $isActive := .Params.is_active | default true -}}
  {{- if not $isActive }}{{ continue }}{{ end -}}

  {{- if ne $currentLang "en" -}}
    {{- $currentKey := printf "%s::%s" $canonicalPath $currentLang -}}
    {{- $currentStatus := index $translationStatusData $currentKey | default "placeholder" -}}
    {{- if not (in $liveStatuses $currentStatus) }}{{ continue }}{{ end -}}
  {{- end -}}

  {{- $priority := "0.7" -}}
  {{- $changefreq := "monthly" -}}
  {{- if or (eq $canonicalPath "/") (eq $canonicalPath "/platform/") -}}
    {{- $priority = "0.9" -}}
    {{- $changefreq = "weekly" -}}
  {{- else if or (hasPrefix $canonicalPath "/platform/pillar-") (eq $canonicalPath "/about/") (eq $canonicalPath "/meet/") -}}
    {{- $priority = "0.8" -}}
    {{- $changefreq = "monthly" -}}
  {{- else if eq $canonicalPath "/endorsements/" -}}
    {{- $priority = "0.7" -}}
    {{- $changefreq = "weekly" -}}
  {{- else if eq $canonicalPath "/platform/uesf-questionnaire/" -}}
    {{- $priority = "0.8" -}}
    {{- $changefreq = "monthly" -}}
  {{- end -}}

  {{- $liveTranslations := slice -}}
  {{- range $page.AllTranslations -}}
    {{- $translation := . -}}
    {{- $translationLang := .Site.Language.Params.bcp47 | default (.Site.Language.LanguageCode | default .Lang) -}}
    {{- $translationCanonicalPath := .Params.canonical_path | default $canonicalPath -}}
    {{- if eq $translationLang "en" -}}
      {{- $liveTranslations = $liveTranslations | append $translation -}}
    {{- else -}}
      {{- $key := printf "%s::%s" $translationCanonicalPath $translationLang -}}
      {{- $status := index $translationStatusData $key | default "placeholder" -}}
      {{- if in $liveStatuses $status -}}
        {{- $liveTranslations = $liveTranslations | append $translation -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $defaultURL := "" -}}
  {{- range $liveTranslations -}}
    {{- $translationLang := .Site.Language.Params.bcp47 | default (.Site.Language.LanguageCode | default .Lang) -}}
    {{- if eq $translationLang "en" -}}{{- $defaultURL = .Permalink -}}{{- end -}}
  {{- end }}
  <url>
    <loc>{{ $page.Permalink }}</loc>
    <lastmod>{{ $page.Lastmod.Format "2006-01-02" }}</lastmod>
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
    {{- with $defaultURL }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ . }}" />
    {{- end -}}
    {{- range $liveTranslations }}
    {{- $translationLang := .Site.Language.Params.bcp47 | default (.Site.Language.LanguageCode | default .Lang) }}
    <xhtml:link rel="alternate" hreflang="{{ $translationLang }}" href="{{ .Permalink }}" />
    {{- end }}
  </url>
{{- end }}
</urlset>
